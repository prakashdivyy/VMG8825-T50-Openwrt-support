#!/bin/sh
#
# Configure default Wi-Fi settings for Zyxel VMG8825-T50.
# Based on stock firmware SingleSKU power tables:
# - 5GHz (radio1): external PA saturates if driven above 16 dBm on UNII-1 (channels 36-48),
#   resulting in EVM distortion, retries, and MCS drops. 13-14 dBm keeps it linear.
# - 2.4GHz (radio0): 3-stream (3T) beamforming power is capped at 13 dBm on channels 1-6.
#
. /lib/functions.sh

[ "$(board_name)" = "zyxel,vmg8825-t50" ] || exit 0

uci -q set wireless.radio0.txpower='13'
uci -q set wireless.radio1.txpower='14'
uci -q commit wireless

exit 0
