# Re-apply the RPS mask whenever a network interface appears.
#
# econet-eth probes at roughly 14s, well after rcS has already run
# /etc/rc.d/S21rps, so at boot the init script finds no
# /sys/class/net/eth0/queues/rx-* yet and silently does nothing. This
# hotplug hook is what actually lands the mask on a cold boot; it also
# applies to Wi-Fi interfaces (phy*-ap*, wlan*) and br-lan so Wi-Fi NAPI
# softirqs are distributed across CPUs 1-3 rather than bottlenecking CPU0.
#
# See /etc/init.d/rps for why the mask is 0xe.

[ "$ACTION" = "add" ] || exit 0

case "$DEVICENAME" in
	eth0|phy*-ap*|wlan*|br-lan) ;;
	*) exit 0 ;;
esac

for q in /sys/class/net/"$DEVICENAME"/queues/rx-*/rps_cpus; do
	[ -e "$q" ] && echo e > "$q"
done

exit 0
